rules_version = '2';

// The app talks to Firestore directly from the client — there is no longer a
// trusted backend using the Admin SDK, so every access check the Express
// routes used to perform has to be expressed here instead.
//
// The central design point is that rules grant access per DOCUMENT and cannot
// hide individual fields. So a profile is split in two: users/{uid} keeps the
// private copy (email, exact coordinates) readable only by its owner, and
// publicProfiles/{uid} holds the subset other people may see, with location
// coarsened by the client before it is written. Nothing sensitive lives in a
// document that other users can read.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function swipePath(fromUid, toUid) {
      return /databases/$(database)/documents/swipes/$(fromUid + '_' + toUid);
    }

    // True only when both people have swiped 'like' on each other. Rules can
    // read documents the requesting client itself is not allowed to read,
    // which is what makes it possible to verify a mutual like without
    // exposing anyone's swipes to the client.
    function likedEachOther(a, b) {
      return exists(swipePath(a, b))
        && get(swipePath(a, b)).data.direction == 'like'
        && exists(swipePath(b, a))
        && get(swipePath(b, a)).data.direction == 'like';
    }

    function isParticipant(matchId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.uids;
    }

    // Private profile: email and exact location. Owner-only, both ways.
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Public profile: what the discover feed and match screens display.
    // Readable by any signed-in user, writable only by its subject. The
    // client coarsens location before writing; that is not re-checked here
    // because publishing a precise location to your own public profile can
    // only expose the person doing it, and float comparisons in rules are
    // not reliable enough to enforce it usefully.
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow write: if isOwner(uid) && !('email' in request.resource.data);
    }

    // Swipes are write-once-ish and private to the swiper. Deliberately NOT
    // readable by the person swiped on: that would turn into a "who liked
    // me" feed. Match creation below still verifies reciprocity, because
    // rules can read what clients cannot.
    match /swipes/{swipeId} {
      allow read: if signedIn() && resource.data.swiperUid == request.auth.uid;
      allow create, update: if signedIn()
        && request.resource.data.swiperUid == request.auth.uid
        && request.resource.data.targetUid != request.auth.uid
        && swipeId == request.auth.uid + '_' + request.resource.data.targetUid
        && request.resource.data.direction in ['like', 'pass'];
      allow delete: if false;
    }

    match /matches/{matchId} {
      allow read: if signedIn() && request.auth.uid in resource.data.uids;

      // A client may only bring a match into existence when the mutual like
      // is already on record, so a match cannot be fabricated to force a
      // conversation with someone who never liked back. uids is required to
      // be the sorted pair, which makes the document id derivable and stops
      // duplicate matches for the same two people.
      allow create: if signedIn()
        && request.resource.data.uids.size() == 2
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.uids[0] < request.resource.data.uids[1]
        && matchId == request.resource.data.uids[0] + '_' + request.resource.data.uids[1]
        && likedEachOther(request.resource.data.uids[0], request.resource.data.uids[1]);

      allow update: if false;

      // Unmatching is permanent and total, and either participant can do it.
      allow delete: if signedIn() && request.auth.uid in resource.data.uids;

      match /messages/{messageId} {
        allow read: if isParticipant(matchId);
        allow create: if isParticipant(matchId)
          && request.resource.data.senderId == request.auth.uid;
        allow update: if false;
        // Needed so unmatching can purge the history from the client. It
        // also lets a participant delete an individual message, which is an
        // accepted trade: either of them could already destroy the entire
        // conversation by unmatching.
        allow delete: if isParticipant(matchId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
