rules_version = '2';

// All access goes through the backend using the Firebase Admin SDK, which
// bypasses these rules. This minimal ruleset just keeps direct client SDK
// access locked down for the Firestore emulator/console.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
