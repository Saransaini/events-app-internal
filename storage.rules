rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Dog photos, uploaded by PhotoUploader.tsx to dog-photos/{uid}/{filename}.
    // Readable by any signed-in user (discover cards and matches need to see
    // other users' photos), writable only by the owner of that uid folder.
    match /dog-photos/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
