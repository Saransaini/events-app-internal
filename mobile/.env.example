# Firebase client SDK config (from your Firebase project settings > General > Your apps)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Base URL of the backend API (src/app.js), e.g. http://localhost:8082 for
# local dev against `npm start` in the repo root, or your deployed URL.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8082

# Google sign-in (optional). Leave all three blank to hide the "Continue
# with Google" button entirely. See README.md.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
